# ───────────────────────── Core
# PostgreSQL connection string. Local default matches docker-compose.yml.
DATABASE_URL="postgresql://sukkot:sukkot@localhost:5432/sukkot?schema=public"
# Public base URL of the web app (used for links in emails, sitemaps and payment callbacks).
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -hex 32`. Used to sign private file URLs and hash IPs.
APP_SECRET="change-me-to-a-long-random-string"

# ───────────────────────── Storage
# "local" stores files under ./storage (development). "s3" uses any S3-compatible bucket (R2, S3, B2).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional CDN origin for public images (leave empty to serve through the app).
STORAGE_PUBLIC_BASE_URL=""

# ───────────────────────── Email
# "console" logs emails (development). "resend" sends through Resend.
EMAIL_DRIVER="console"
EMAIL_FROM="Sukkot Salone <no-reply@example.sl>"
# Listing, offers, applications and payments need a confirmed email or phone. Defaults to on only
# when EMAIL_DRIVER=resend or SMS_DRIVER=twilio (people can receive the link or code); set true or
# false to override.
# REQUIRE_EMAIL_VERIFICATION=""
RESEND_API_KEY=""

# ───────────────────────── Text messages (phone verification codes)
# "console" logs texts (development; demo sites show the code on screen). "twilio" sends through Twilio.
SMS_DRIVER="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Either a Messaging Service SID (recommended, can use an alphanumeric sender) or a sending number.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM=""

# ───────────────────────── Payments
# Comma-separated list of methods enabled for checkout. SANDBOX must never be enabled in production.
PAYMENT_METHODS_ENABLED="SANDBOX,BANK_TRANSFER,CASH,MANUAL"
SANDBOX_WEBHOOK_SECRET="dev-sandbox-secret"

# Orange Money Sierra Leone (Orange Developer – Orange Money Web Payment). Requires merchant onboarding.
ORANGE_MONEY_API_BASE="https://api.orange.com"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_COUNTRY="sl"
# Shared secret used to verify our signed `notif_token` on callbacks.
ORANGE_MONEY_WEBHOOK_SECRET=""

# Africell Afrimoney. Endpoints and field names must be confirmed against the merchant API pack.
AFRIMONEY_API_BASE=""
AFRIMONEY_MERCHANT_ID=""
AFRIMONEY_API_KEY=""
AFRIMONEY_WEBHOOK_SECRET=""

# ───────────────────────── AI chat assistant
# With a key from console.anthropic.com the chat button holds real conversations and searches
# listings. Without one it gives fixed answers to common questions.
ANTHROPIC_API_KEY=""
# Optional: another Claude model, e.g. a cheaper one. Default claude-opus-5-5.
ASSISTANT_MODEL=""

# ───────────────────────── Misc
# Show the demo-data banner and allow seeded demo accounts to sign in (never in production).
DEMO_MODE="true"
